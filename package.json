{
  "name": "annal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:contracts": "cd contracts && forge test",
    "gate:contracts": "cd contracts && forge fmt --check && forge lint --deny warnings && forge build --sizes && forge test",
    "gate": "npm run lint -- --max-warnings=0 && npm run typecheck && npm run build && npm run gate:contracts",
    "abi": "cd contracts && forge build >/dev/null && cd .. && node scripts/gen-abi.mjs",
    "vercel:lekan": "vercel --global-config ~/.config/vercel-lekan --scope lekan6"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "@phosphor-icons/react": "2.1.10",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "uqr": "0.1.3",
    "viem": "2.57.20"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
